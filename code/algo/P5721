n = int(input())
a=0
while n>=1:
    for i in range(n):
        a+=1
        #f"{a:02d},0是填充字符：宽度不足时补 0（默认是补空格）
        # 2是指最小宽度：至少占 2 个字符；超过则完整保留，不截断
        # d是指数据类型：按十进制整数处理（int 可省略，写了更明确）
        #end=""是指print结束输出空格，不换行，正常默认是end="/n",/n是换行
        print(f"{a:02d}",end="")
    print()
    n-=1
